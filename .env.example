# Firebase web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key

# Cloudinary public upload settings
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_restricted_upload_preset

# Paystack public key only
VITE_PAYSTACK_PUBLIC_KEY=pk_test_or_live_public_key

# Never commit backend-only secrets.
# Do not put Cloudinary API secrets, Paystack secret keys, or service account keys in VITE variables.
