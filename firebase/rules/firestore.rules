rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if isActiveAdmin();
    }

    match /projects/{projectId} {
      allow read: if isActiveAdmin() || resource.data.publishStatus == 'published';
      allow create, update, delete: if isActiveAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if isActiveAdmin() || resource.data.publishStatus == 'published';
      allow create, update, delete: if isActiveAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if isActiveAdmin() || resource.data.approved == true;
      allow create, update, delete: if isActiveAdmin();
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    match /faq/{faqId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'global';
      allow write: if isActiveAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'global';
      allow write: if isActiveAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if isActiveAdmin();
    }

    match /payments/{paymentId} {
      allow create: if request.resource.data.keys().hasAll(['reference', 'email', 'amountGhs', 'amountPesewas'])
        && request.resource.data.reference is string
        && request.resource.data.email is string
        && request.resource.data.amountGhs is number
        && request.resource.data.amountPesewas is number;
      allow read, update, delete: if isActiveAdmin();
    }

    match /clients/{clientId} {
      allow read, write: if isActiveAdmin();
    }

    match /activityLogs/{logId} {
      allow read, create: if isActiveAdmin();
      allow update, delete: if isActiveAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
